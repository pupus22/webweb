{
  "name": "polycomp-erp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node -e \"const fs = require('fs'); fs.copyFileSync('template.html', 'index.html');\"",
    "dev": "vite",
    "prebuild": "node -e \"const fs = require('fs'); fs.copyFileSync('template.html', 'index.html');\"",
    "build": "vite build",
    "postbuild": "node -e \"const fs = require('fs'); fs.copyFileSync('dist/index.html', 'index.html'); fs.cpSync('dist/assets', 'assets', {recursive: true});\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10"
  }
}
